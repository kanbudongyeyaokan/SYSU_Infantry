  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\SYSU_Infantry\SYSU_Infantry\SYSU_Infantry\build\Debug\cmake\stm32cubemx && "D:\Clion\CLion 2025.2\bin\cmake\win\x64\bin\cmake.exe" --regenerate-during-build -SD:\SYSU_Infantry\SYSU_Infantry\SYSU_Infantry -BD:\SYSU_Infantry\SYSU_Infantry\SYSU_Infantry\build\Debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build cmake/stm32cubemx/rebuild_cache: phony cmake/stm32cubemx/CMakeFiles/rebuild_cache.util

# =============================================================================
# Target aliases.

build FreeRTOS: phony cmake/stm32cubemx/FreeRTOS

build STM32_Drivers: phony cmake/stm32cubemx/STM32_Drivers

build SYSU_Infantry: phony SYSU_Infantry.elf

build USB_Device_Library: phony cmake/stm32cubemx/USB_Device_Library

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: D:/SYSU_Infantry/SYSU_Infantry/SYSU_Infantry/build/Debug

build all: phony SYSU_Infantry.elf cmake/stm32cubemx/all

